# --- Local SQLite (default for v1). Switch to a Supabase Postgres URL when ready.
DATABASE_URL=sqlite://./data.db

# --- Server
PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Per-deployment identity (KEEP OUT OF GIT — set yours here, don't commit)
# Used in outbound User-Agent strings so remote sources can contact your deployment.
CONTACT_EMAIL=

# --- Path to YOUR marble knowledge-graph JSON (KEEP OUT OF GIT).
# Per-deployment. The engine reads this file READ-ONLY and never persists
# KG content back to data.db.
MARBLE_KG_PATH=

# --- Shared secret for /me/* personalized routes.
# Calendar apps can't send headers, so we pass this as a ?token= query param.
# Generate with: openssl rand -hex 24
ME_TOKEN=

# --- SMTP for the autonomous weekly cron (used by `bun run deliver --send`).
# For Gmail: enable 2-Step Verification, then generate an App Password at
# https://myaccount.google.com/apppasswords ("Mail" / "Other: events-x-marble").
# Paste the 16-char password (no spaces) as SMTP_PASS.
# KEEP OUT OF GIT.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# --- LLM keys
# OpenCode Zen (https://opencode.ai) — primary gateway.
#   Free models for Tier 1 extraction (Nemotron / DeepSeek / MiniMax)
#   Paid Haiku 4.5 for Tier 2 enrichment
# Endpoints:
#   POST https://opencode.ai/zen/v1/chat/completions  (OpenAI-format models)
#   POST https://opencode.ai/zen/v1/messages          (Anthropic-format Claude models)
OPENCODE_API_KEY=

# Optional direct Anthropic key (skip if you route Claude through Zen)
ANTHROPIC_API_KEY=

# Brave Search (Phase 3 search-assisted scout, optional)
BRAVE_SEARCH_API_KEY=
