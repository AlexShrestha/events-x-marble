# Local SQLite (default for v1). Switch to a Supabase Postgres URL when ready.
DATABASE_URL=sqlite://./data.db

# Server
PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-string

# LLM keys
# OpenCode Zen (https://opencode.ai) is the AI gateway. It serves:
#   - free models (DeepSeek V4 Flash Free, MiniMax M2.5 Free, etc.) for Tier 1 extraction
#   - paid Claude Haiku 4.5 for Tier 2 enrichment via OpenAI-compatible endpoints
# Endpoints:
#   POST https://opencode.ai/zen/v1/chat/completions  (OpenAI-format models)
#   POST https://opencode.ai/zen/v1/messages          (Anthropic-format Claude models)
OPENCODE_API_KEY=

# Optional direct Anthropic key (skip if you route Claude through Zen)
ANTHROPIC_API_KEY=

# Tier 3 deep research uses the local `claude` CLI subprocess; no key needed here.

# Brave Search API for the open-web research agent (Phase 3, optional now)
BRAVE_SEARCH_API_KEY=
