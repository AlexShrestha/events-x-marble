{
  "name": "events-x-marble",
  "version": "0.1.0",
  "description": "Personalized event discovery for marble users. Scores upcoming events in your city against your marble KG, pushes a sanitized rent payload to events.timesmarble.com — KG and API key stay on your laptop.",
  "type": "module",
  "bin": {
    "events-x-marble": "bin/exm.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "preinstall": "node ../../scripts/preinstall-marble.mjs",
    "sync:marble": "node ../../scripts/preinstall-marble.mjs && npm install --force",
    "test:dry-init": "node bin/exm.mjs init --dry-run"
  },
  "dependencies": {
    "@alexshrestha/marble": "^0.3.0"
  },
  "keywords": [
    "marble",
    "events",
    "personalization",
    "barcelona"
  ],
  "author": "Alex Shrestha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexShrestha/events-x-marble"
  }
}
