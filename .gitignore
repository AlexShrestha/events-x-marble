# --- deps + build
node_modules/
dist/
.cache/

# --- secrets + per-deployment env (NEVER commit)
.env
.env.local
.env.*.local

# --- local database + WAL files
data.db
data.db-journal
data.db-wal
data.db-shm

# --- per-deployment private overlays (anything alex/user-specific lives here)
private/
local/
*.local.ts
*.local.json

# --- marble knowledge-graph files (paranoia: never let any KG-shaped JSON into git)
*-kg.json
*.kg.json
*marble*kg*.json
*kg-full*.json

# --- misc
*.log
.DS_Store
.vercel
.claude/

# --- CLI's own runtime state (created by `events-x-marble init` on contributors' machines)
.events-x-marble/
packages/cli/node_modules/

# --- Vercel build artifacts (esbuild bundles src/vercel-entry.ts)
api/[...path].mjs
api/[...path].mjs.map
api/[[...path]].mjs
api/[[...path]].mjs.map
api/index.mjs
api/index.mjs.map
